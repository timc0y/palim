{
  "name": "palim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "From thought to page. Illustrated EPUBs and unchanged ebook forwarding.",
  "license": "MIT",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "build": "wrangler deploy --dry-run --outdir dist",
    "example": "tsx scripts/example.ts",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xmldom/xmldom": "0.8.11",
    "arctic": "3.7.0",
    "jszip": "3.10.1",
    "markdown-it": "14.1.0",
    "pele": "1.10.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260730.1",
    "@types/markdown-it": "14.1.2",
    "@types/node": "22.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "wrangler": "4.115.0"
  }
}
