{
  "name": "palim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "From thought to page. Illustrated EPUBs and unchanged ebook forwarding.",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "npm run example && wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "build": "npm run example && npm run plugin && wrangler deploy --dry-run --outdir dist",
    "example": "tsx scripts/example.ts",
    "deploy": "node scripts/preflight.mjs && npm run check && npm run example && npm run plugin && wrangler deploy",
    "deploy:pages": "node scripts/preflight.mjs && npm run check && node scripts/deploy-pages.mjs",
    "plugin": "node scripts/package-plugin.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xmldom/xmldom": "0.8.15",
    "better-auth": "1.7.12",
    "jszip": "3.10.1",
    "markdown-it": "14.3.3",
    "pele": "1.10.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260730.1",
    "@types/markdown-it": "14.1.2",
    "@types/node": "22.19.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "wrangler": "4.115.0"
  }
}
