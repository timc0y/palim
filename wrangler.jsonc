{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palim",
  "account_id": "04d3e478b1ddf0f5147120cacbf430de",
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "palim",
      "database_id": "7328bb73-47d8-415c-9c21-7efe595961e8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BOOKS", "bucket_name": "palim-books" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "dc5983f38af844d6bf40e27b8c720937" }],
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "1432932416",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": false },
  "vars": {
    "ORIGIN": "https://palim-timc0y.pages.dev",
    "SENDER": "reading@palim.timc0y.com"
  }
}
