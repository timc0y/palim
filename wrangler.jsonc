{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palim",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "palim", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "BOOKS", "bucket_name": "palim-books" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": false },
  "vars": { "ORIGIN": "http://localhost:8787", "SENDER": "reading@your-verified-domain.example", "FILE_ORIGINS": "" }
}
